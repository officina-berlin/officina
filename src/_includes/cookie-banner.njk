{#- Only shown when nobody has answered yet. Until then PostHog is already
    counting the visit cookielessly, so the copy says what accepting actually
    adds rather than asking for a favour. -#}
<div id="cookie-banner" class="hidden bottom-0 left-0 right-0 bg-kobi z-401 border-t border-black">
  <div class="p-6 max-w-(--breakpoint-xl) mx-auto">
    <p class="max-w-2xl">
      {{ ui.cookieText }}
    </p>
    <button
      id="accept-cookie"
      class="inline-block mt-4 mr-2 border border-black rounded-xl bg-black text-white px-3 py-1 transition-colors duration-150 hover:bg-white hover:text-black"
    >{{ ui.cookieAccept }}</button>
    <button
      id="decline-cookie"
      class="inline-block mt-4 border border-black rounded-xl px-3 py-1 transition-colors duration-150 hover:bg-black hover:text-white"
    >{{ ui.cookieDecline }}</button>
  </div>
</div>
