{#- Not fixed: it scrolls away with the page. That is also why the boosted nav
    links swap with `show:window:top` – `show:top` would scroll <main> to the
    top of the viewport and leave the header above it. -#}
<header
  class="flex bg-white xl:h-16 items-center border-b border-black"
>
  <div
    class="w-full max-w-(--breakpoint-xl) relative mx-auto px-4 flex flex-col xl:flex-row"
  >
    <div class="flex shrink-0 items-center py-2 xl:py-0">
      <button
        type="button"
        id="sidebar-open"
        aria-label="{{ ui.openSidebar }}"
        class="flex mr-2 px-2 items-center xl:hidden text-black focus:outline-hidden focus:text-gray-700"
      >
        <svg
          class="fill-current w-4 h-4"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
        >
          <path d="M0 3h20v2H0V3zm0 6h20v2H0V9zm0 6h20v2H0v-2z"></path>
        </svg>
      </button>
      <a href="/{{ page.lang }}/" class="font-bold text-xl pt-1">
        <img
          src="/_assets/img/logo.gif"
          class="object-contain h-10 w-auto xl:h-[59px]"
          height="59"
          alt="Officina Kreuzberg"
          title="Officina Kreuzberg"
        />
      </a>
      {#- The language switch sits in the top bar on small screens rather than
          in the menu, so it is visible without opening anything. The xl one
          is at the end of #sidebar below. `otherLangUrl` is set in layout.njk. -#}
      <a
        id="lang-switch"
        href="{{ otherLangUrl }}"
        hreflang="{{ otherLang }}"
        lang="{{ otherLang }}"
        class="ml-auto flex items-center gap-2 py-2 text-smc font-bold font-hany transition-colors duration-150 hover:text-blue-custom xl:hidden"
      >
        <svg aria-hidden="true" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        {{ "Deutsch" if otherLang == "de" else "English" }}
      </a>
    </div>
    {#- These links swap only <main>, so the header and footer stay from the
        first page loaded. `hx-select-oob` (inherited by every link here) pulls
        the language switches from the new page too – otherwise they would
        keep pointing at the first page's translation. -#}
    <div
      id="sidebar"
      hx-select-oob="#lang-switch,#lang-switch-xl,#footer-lang-switch"
      class="flex flex-col items-start pb-4 xl:pb-0 ml-6 xl:flex-row xl:items-stretch xl:grow xl:justify-end hidden xl:flex text-smc font-bold font-hany"
    >
      <a
        href="/{{ page.lang }}/"
        class="py-2 px-4 my-1 xl:my-3 mr-5 transition-colors duration-150 hover:text-blue-custom"
        hx-get="/{{ page.lang }}/"
        hx-select="main"
        hx-target="main"
        hx-swap="outerHTML show:window:top"
        hx-push-url="true"
      >
        {{ menu.desks }}
      </a>
      <a
        href="/{{page.lang}}/about"
        class="py-2 px-4 my-1 xl:my-3 mr-5 transition-colors duration-150 hover:text-blue-custom"
        hx-get="/{{page.lang}}/about"
        hx-select="main"
        hx-target="main"
        hx-swap="outerHTML show:window:top"
        hx-push-url="true"
      >
        {{ menu.about }}
      </a>
      <a
        href="/{{ page.lang }}/collective"
        class="py-2 px-4 my-1 xl:my-3 mr-5 transition-colors duration-150 hover:text-blue-custom"
        hx-get="/{{ page.lang }}/collective"
        hx-select="main"
        hx-target="main"
        hx-swap="outerHTML show:window:top"
        hx-push-url="true"
      >
        {{ menu.collective }}
      </a>
      <a
        href="/{{ page.lang }}/events"
        class="py-2 px-4 my-1 xl:my-3 mr-5 transition-colors duration-150 hover:text-blue-custom"
        hx-get="/{{ page.lang }}/events"
        hx-select="main"
        hx-target="main"
        hx-swap="outerHTML show:window:top"
        hx-push-url="true"
      >
        {{ menu.events }}
      </a>
      <a
        href="https://docs.google.com/forms/d/e/1FAIpQLSe_aJwPcxRE_1LtocSHlrjHqDOQhm763ElOiURhH6KCOzL96g/viewform"
        target="_blank"
        data-ph-location="header"
        class="w-2/3 xl:w-auto bg-black text-white border border-black rounded-xl py-2 px-4 my-2 xl:my-3 transition-colors duration-150 hover:bg-white hover:text-black"
      >
        {{ menu.contact }}
      </a>
      <a
        id="lang-switch-xl"
        href="{{ otherLangUrl }}"
        hreflang="{{ otherLang }}"
        lang="{{ otherLang }}"
        class="hidden xl:flex items-center gap-2 py-2 px-4 my-3 ml-5 transition-colors duration-150 hover:text-blue-custom"
      >
        <svg aria-hidden="true" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        {{ "Deutsch" if otherLang == "de" else "English" }}
      </a>
    </div>
  </div>
</header>
