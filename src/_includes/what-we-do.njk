<div class="max-w-(--breakpoint-lg) w-full mx-auto px-4 flex flex-col gap-12">
  <div class="flex flex-col gap-4 md:max-w-2xl">
    <h2 class="font-bold font-hany text-3xl md:text-5xl leading-tight text-black">
      {{ how_it_works_title or "How it works" }}
    </h2>
    <p>{{ how_it_works_description or we_share_skills_description }}</p>
  </div>
  <div class="grid gap-12 md:grid-cols-3">
    <div class="border-t-2 border-black pt-6 flex flex-col gap-4">
      <h3 class="text-3xl font-hany">{{ collective_title or "The collective" }}</h3>
      <p>{{ the_collective }}</p>
      <div class="mt-auto">
        <a
          href="/{{ page.lang }}/collective"
          class="inline-block border border-black rounded-xl px-3 py-1 transition-colors duration-150 hover:bg-black hover:text-white"
        >{{ collective_cta or "Learn more" }}</a>
      </div>
    </div>
    <div class="border-t-2 border-black pt-6 flex flex-col gap-4">
      <h3 class="text-3xl font-hany">{{ events_title or "Events" }}</h3>
      <p>{{ events }}</p>
      <div class="mt-auto">
        <a
          href="/{{ page.lang }}/events"
          class="inline-block border border-black rounded-xl px-3 py-1 transition-colors duration-150 hover:bg-black hover:text-white"
        >{{ events_cta or "Learn more" }}</a>
      </div>
    </div>
    <div class="border-t-2 border-black pt-6 flex flex-col gap-4">
      <h3 class="text-3xl font-hany">{{ residency_title or "Artist residency (archive)" }}</h3>
      <p>{{ art_residency }}</p>
      <div class="mt-auto">
        <a
          href="/en/artists"
          hreflang="en"
          class="inline-block border border-black rounded-xl px-3 py-1 transition-colors duration-150 hover:bg-black hover:text-white"
        >{{ residency_cta or "Learn more" }}</a>
        {%- if ui.englishOnly %}
        <p class="text-xs italic mt-2">{{ ui.englishOnly }}</p>
        {%- endif %}
      </div>
    </div>
  </div>
</div>
