---
layout: layout.njk
---
<div class="flex flex-col gap-20 md:gap-32 pb-20 bg-[url('/_assets/img/smiley.svg')] bg-left-top bg-no-repeat bg-size-[535px]">
  {%- set heroText = content -%}
  {%- set heroAlt = "Artist residency at Officina Kreuzberg" -%}
  {% include 'page-hero.njk' %}
  <div class="max-w-(--breakpoint-lg) w-full mx-auto px-4 flex flex-col gap-12">
    <h2 class="font-bold font-hany text-3xl md:text-5xl leading-tight text-black">
      The residents
    </h2>
    <div class="flex flex-col gap-20">
      {%- for artist in collections.artist | sortByPosition | reverse %}
      <div class="flex flex-col md:flex-row gap-8 md:gap-12">
        <div class="md:w-1/3 shrink-0">
          <div class="border-2 border-black rounded-xl overflow-hidden {{ '-rotate-2' if loop.index is odd else 'rotate-2' }}">
            {% image artist.data.image, artist.data.name, 600, "w-full h-auto" %}
          </div>
        </div>
        <div class="md:w-2/3 flex flex-col gap-3">
          <h3 class="font-hany text-3xl leading-tight">{{ artist.data.name }}</h3>
          <div class="italic text-sm">{{ artist.data.period }}</div>
          <div class="space-y-4 md:max-w-2xl mt-2">
            {{ artist.templateContent | safe }}
          </div>
          {% if artist.data.website %}
          <div>
            <a
              target="_blank"
              rel="noopener"
              href="{{ artist.data.website }}"
              class="underline underline-offset-4 decoration-1 hover:decoration-2 break-all"
            >{{ artist.data.website }}</a>
          </div>
          {% endif %}
        </div>
      </div>
      {%- endfor %}
    </div>
  </div>
</div>
