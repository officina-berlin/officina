<footer class="w-full">
  <div class="text-sm max-w-(--breakpoint-xl) mx-auto px-4 py-12 flex justify-between items-end gap-4">
    <div>
      <div>
        <div class="font-bold font-hany">Officina</div>
        <div>Jahnstraße 13</div>
        <div>10967 Berlin</div>
      </div>
      <div class="mt-4 font-bold text-xs">
        <a
          href="https://www.facebook.com/OfficinaNeukoelln/"
          data-ph-location="footer"
          target="_blank"
          rel="noopener"
        >
          <img src="/_assets/img/fb.svg" class="inline" alt="Facebook logo" />
          <span class="ml-2">Facebook</span>
        </a>
        <a
          href="https://www.instagram.com/officinakreuzberg/"
          data-ph-location="footer"
          class="ml-2"
          target="_blank"
          rel="noopener"
        >
          {% image "./src/_assets/img/insta.png", "Instagram logo", 20, "inline"
          %}
          <span class="ml-2">Instagram</span>
        </a>
        <a href="mailto:hello@officina.berlin" data-ph-location="footer" class="ml-2">
          {% image "./src/_assets/img/mail.png", "Email logo", 20, "inline" %}
          <span class="ml-2">{{ ui.emailLabel }}</span>
        </a>
      </div>
      <div class="mt-4 text-xs">
        <span>{{ ui.creditsMadeBy }} </span>
        <a href="https://loicnogu.es" class="underline" target="_blank">{{ ui.creditsMe }}</a>
        <span> {{ ui.creditsAnd }} </span>
        <a href="https://christian-stoss.com" class="underline" target="_blank"
          >{{ ui.creditsHim }}</a
        >
        <span> | </span>
        <button id="show-cookie-banner">{{ ui.cookieSettings }}</button>
        <span> | </span>
        {#- Stay on the same page when the other language has it, instead of
            throwing the visitor back to the home page. `locale_links` lists only
            the *other* locales that actually have this URL, and the site has two
            languages, so its first entry is the one we want – and it is empty for
            /en/artists/, which has no German version, hence the home-page
            fallback. Trim `.html` the way the canonical does. -#}
        {%- set alternate = (page.url | locale_links)[0] -%}
        {%- set otherUrl = (alternate.url | replace(".html", "")) if alternate else ("/de/" if page.lang == "en" else "/en/") %}
        <a href="{{ otherUrl }}" class="underline">
          {{- "Wechseln zu Deutsch" if page.lang == "en" else "Switch to English" -}}
        </a>
      </div>
    </div>
    <div class="flex flex-col items-end gap-1">
      <a href="/{{ page.lang }}/imprint" class="font-bold font-hany underline-offset-4 hover:underline">{{ ui.imprint }}</a>
      <a href="/{{ page.lang }}/privacy" class="font-bold font-hany underline-offset-4 hover:underline">{{ ui.privacy }}</a>
    </div>
  </div>
</footer>
